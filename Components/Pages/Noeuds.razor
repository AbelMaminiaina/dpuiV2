@page "/"
@page "/noeuds"
@inject LignageApp.ViewModels.NoeudsListViewModel ViewModel
@inject NavigationManager Navigation
@implements IDisposable
@rendermode InteractiveServer

<h3>Noeuds du graphe de lignage</h3>

@if (ViewModel.EnChargement)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead><tr><th>Noeud</th></tr></thead>
        <tbody>
            @foreach (var n in ViewModel.Noeuds)
            {
                <tr @onclick="() => AllerVersConsultation(n.Id)" style="cursor:pointer">
                    <td title="@n.Noeud">@Tronquer(n.Noeud, 50)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnChanged;
        await ViewModel.ChargerAsync();
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void AllerVersConsultation(string id)
    {
        // id est déjà au format: lnaUid|linUid|edgDir
        // On l'encode pour l'URL
        var encoded = Uri.EscapeDataString(id);
        Navigation.NavigateTo($"/consultation/{encoded}");
    }

    private string Tronquer(string texte, int max)
    {
        if (string.IsNullOrEmpty(texte) || texte.Length <= max)
            return texte;
        return texte.Substring(0, max) + "...";
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnChanged;
    }
}
