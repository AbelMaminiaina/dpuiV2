@page "/consultation/{Pk}"
@inject LignageApp.ViewModels.ConsultationViewModel ViewModel
@implements IDisposable
@rendermode InteractiveServer
@using LignageApp.Models

<link href="css/lignage-graph.css" rel="stylesheet" />

<div style="display:flex">
    <div style="flex:1">
        <button @onclick="ViewModel.Retour" disabled="@(!ViewModel.PeutRevenirEnArriere)">← Retour</button>
        <button @onclick="ViewModel.Avancer" disabled="@(!ViewModel.PeutAllerEnAvant)">Avancer →</button>
        <button @onclick="ViewModel.RetourAvecSuppression" disabled="@(ViewModel.Historique.Count <= 1)">← Précédent (supprimer)</button>
        <button @onclick="ViewModel.ToggleHistorique">Historique</button>
        <button @onclick="ToggleGraphe">@(GrapheVisible ? "Masquer Graphe" : "Afficher Graphe")</button>
        <h3 title="@ViewModel.NoeudActuel">Lignage du noeud : @Tronquer(ViewModel.NoeudActuel, 50)</h3>

        @if (ViewModel.Programme != null)
        {
            <div style="margin-bottom:15px; padding:10px; background:#f5f5f5; border-radius:5px">
                <strong>Programme :</strong> @ViewModel.Programme.Programme<br/>
                <strong>Version :</strong> @ViewModel.Programme.Version
            </div>
        }

        @if (GrapheVisible)
        {
            <LignageApp.Components.LignageGraph
                NoeudActuel="@ViewModel.NoeudActuel"
                Successeurs="@ViewModel.Successeurs"
                Predecesseurs="@ViewModel.Predecesseurs"
                Historique="@ViewModel.Historique"
                ContainerId="graphe-container" />

            <div class="graph-legend">
                <div class="graph-legend-item">
                    <span class="graph-legend-dot actuel"></span>
                    <span>Actuel</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot predecesseur"></span>
                    <span>Prédécesseurs</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot successeur"></span>
                    <span>Successeurs</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot historique"></span>
                    <span>Historique</span>
                </div>
            </div>
        }

        <h4>Successeurs</h4>
        <table class="table">
            <thead><tr><th>Noeud</th><th>Transformation</th></tr></thead>
            <tbody>
                @foreach (var s in ViewModel.Successeurs)
                {
                    <tr @onclick="() => ViewModel.NaviguerVersAsync(s.Id)" style="cursor:pointer">
                        <td title="@s.Noeud">@Tronquer(s.Noeud, 50)</td><td>@s.Transformation</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Predecesseurs</h4>
        <table class="table">
            <thead><tr><th>Noeud</th><th>Transformation</th></tr></thead>
            <tbody>
                @foreach (var p in ViewModel.Predecesseurs)
                {
                    <tr @onclick="() => ViewModel.NaviguerVersAsync(p.Id)" style="cursor:pointer">
                        <td title="@p.Noeud">@Tronquer(p.Noeud, 50)</td><td>@p.Transformation</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewModel.DrawerOuvert)
    {
        <div style="width:250px; border-left:1px solid #ccc; padding:10px">
            <div style="display:flex; justify-content:space-between">
                <strong>Historique</strong>
                <button @onclick="ViewModel.ToggleHistorique">X</button>
            </div>
            <ul style="list-style:none; padding:0">
                @for (int i = 0; i < ViewModel.Historique.Count; i++)
                {
                    var index = i;
                    var entry = ViewModel.Historique[i];
                    var isActuel = i == ViewModel.IndexActuel;
                    <li @onclick="() => ViewModel.AllerA(index)"
                        style="cursor:pointer; padding:5px; @(isActuel ? "background:#e0e0e0; font-weight:bold" : "")"
                        title="@entry.Noeud">
                        @Tronquer(entry.Noeud, 25)
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public string Pk { get; set; } = string.Empty;
    private bool GrapheVisible { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Pk))
        {
            // Décoder le paramètre URL
            var decoded = Uri.UnescapeDataString(Pk);
            var pk = LignagePK.Parse(decoded);
            if (pk != null)
            {
                await ViewModel.InitialiserAsync(pk.LnaUid, pk.LinUid, pk.EdgDir);
            }
        }
    }

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnChanged;
    }

    private async void OnChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleGraphe()
    {
        GrapheVisible = !GrapheVisible;
    }

    private string Tronquer(string texte, int max)
    {
        if (string.IsNullOrEmpty(texte) || texte.Length <= max)
            return texte;
        return texte.Substring(0, max) + "...";
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnChanged;
    }
}
