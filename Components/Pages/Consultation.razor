@page "/consultation/{Pk}"
@inject LignageApp.ViewModels.ConsultationViewModel ViewModel
@implements IDisposable
@rendermode InteractiveServer

<link href="css/lignage-graph.css" rel="stylesheet" />

<div style="display:flex">
    <div style="flex:1">
        <button @onclick="ViewModel.GoBack" disabled="@(!ViewModel.CanGoBack)">← Back</button>
        <button @onclick="ViewModel.GoForward" disabled="@(!ViewModel.CanGoForward)">Forward →</button>
        <button @onclick="ViewModel.GoBackWithRemove" disabled="@(ViewModel.History.Count <= 1)">← Previous (remove)</button>
        <button @onclick="ViewModel.ToggleHistory">History</button>
        <button @onclick="ToggleGraph">@(GraphVisible ? "Hide Graph" : "Show Graph")</button>
        <h3 title="@ViewModel.CurrentNode">Node Lineage: @Truncate(ViewModel.CurrentNode, 50)</h3>

        @if (ViewModel.Program != null)
        {
            <div style="margin-bottom:15px; padding:10px; background:#f5f5f5; border-radius:5px">
                <strong>Program:</strong> @ViewModel.Program.Program<br/>
                <strong>Version:</strong> @ViewModel.Program.Version
            </div>
        }

        @if (GraphVisible)
        {
            <LignageApp.Components.LignageGraph
                CurrentNode="@ViewModel.CurrentNode"
                Successors="@ViewModel.Successors"
                Predecessors="@ViewModel.Predecessors"
                History="@ViewModel.History"
                ContainerId="graph-container" />

            <div class="graph-legend">
                <div class="graph-legend-item">
                    <span class="graph-legend-dot actuel"></span>
                    <span>Current</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot predecesseur"></span>
                    <span>Predecessors</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot successeur"></span>
                    <span>Successors</span>
                </div>
                <div class="graph-legend-item">
                    <span class="graph-legend-dot historique"></span>
                    <span>History</span>
                </div>
            </div>
        }

        <h4>Successors</h4>
        <table class="table">
            <thead><tr><th>Node</th><th>Transformation</th></tr></thead>
            <tbody>
                @foreach (var s in ViewModel.Successors)
                {
                    <tr @onclick="() => ViewModel.NavigateToAsync(s.Id)" style="cursor:pointer">
                        <td title="@s.Node">@Truncate(s.Node, 50)</td><td>@s.Transformation</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Predecessors</h4>
        <table class="table">
            <thead><tr><th>Node</th><th>Transformation</th></tr></thead>
            <tbody>
                @foreach (var p in ViewModel.Predecessors)
                {
                    <tr @onclick="() => ViewModel.NavigateToAsync(p.Id)" style="cursor:pointer">
                        <td title="@p.Node">@Truncate(p.Node, 50)</td><td>@p.Transformation</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewModel.DrawerOpen)
    {
        <div style="width:250px; border-left:1px solid #ccc; padding:10px">
            <div style="display:flex; justify-content:space-between">
                <strong>History</strong>
                <button @onclick="ViewModel.ToggleHistory">X</button>
            </div>
            <ul style="list-style:none; padding:0">
                @for (int i = 0; i < ViewModel.History.Count; i++)
                {
                    var index = i;
                    var entry = ViewModel.History[i];
                    var isCurrent = i == ViewModel.CurrentIndex;
                    <li @onclick="() => ViewModel.GoTo(index)"
                        style="cursor:pointer; padding:5px; @(isCurrent ? "background:#e0e0e0; font-weight:bold" : "")"
                        title="@entry.Node">
                        @Truncate(entry.Node, 25)
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public string Pk { get; set; } = string.Empty;
    private bool GraphVisible { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Pk))
        {
            // Decode URL parameter (format: lanUid|linUid|edgDir)
            var decoded = Uri.UnescapeDataString(Pk);
            var parts = decoded.Split('|');
            if (parts.Length == 3)
            {
                var lanUid = Uri.UnescapeDataString(parts[0]);
                var linUid = Uri.UnescapeDataString(parts[1]);
                var edgDir = parts[2];
                await ViewModel.InitializeAsync(lanUid, linUid, edgDir);
            }
        }
    }

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnChanged;
    }

    private async void OnChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleGraph()
    {
        GraphVisible = !GraphVisible;
    }

    private string Truncate(string text, int max)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= max)
            return text;
        return text.Substring(0, max) + "...";
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnChanged;
    }
}
