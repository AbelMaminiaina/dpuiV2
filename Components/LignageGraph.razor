@inject IJSRuntime JS
@using LignageApp.Models

<div id="@ContainerId" class="lignage-graph-container"></div>

@code {
    [Parameter] public string CurrentNode { get; set; } = string.Empty;
    [Parameter] public List<LineageDto> Successors { get; set; } = new();
    [Parameter] public List<LineageDto> Predecessors { get; set; } = new();
    [Parameter] public List<HistoryEntry> History { get; set; } = new();
    [Parameter] public string ContainerId { get; set; } = "graph-container";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RenderGraph();
    }

    private async Task RenderGraph()
    {
        var config = BuildGraphConfig();
        await JS.InvokeVoidAsync("renderHighchartsGraph", ContainerId, config);
    }

    private object BuildGraphConfig()
    {
        var nodes = new List<object>();
        var links = new List<object>();
        var nodeSet = new HashSet<string>();

        // Current node (green)
        var currentNodeTrunc = Truncate(CurrentNode, 20);
        nodeSet.Add(currentNodeTrunc);
        nodes.Add(new { id = currentNodeTrunc, color = "#4CAF50", marker = new { radius = 25 } });

        // Predecessors (blue)
        foreach (var p in Predecessors)
        {
            var pTrunc = Truncate(p.Node, 20);
            if (!nodeSet.Contains(pTrunc))
            {
                nodeSet.Add(pTrunc);
                nodes.Add(new { id = pTrunc, color = "#2196F3", marker = new { radius = 15 } });
            }
            links.Add(new { from = pTrunc, to = currentNodeTrunc });
        }

        // Successors (orange)
        foreach (var s in Successors)
        {
            var sTrunc = Truncate(s.Node, 20);
            if (!nodeSet.Contains(sTrunc))
            {
                nodeSet.Add(sTrunc);
                nodes.Add(new { id = sTrunc, color = "#FF9800", marker = new { radius = 15 } });
            }
            links.Add(new { from = currentNodeTrunc, to = sTrunc });
        }

        // History (gray)
        for (int i = 0; i < History.Count - 1; i++)
        {
            var fromTrunc = Truncate(History[i].Node, 20);
            var toTrunc = Truncate(History[i + 1].Node, 20);

            if (!nodeSet.Contains(fromTrunc))
            {
                nodeSet.Add(fromTrunc);
                nodes.Add(new { id = fromTrunc, color = "#9E9E9E", marker = new { radius = 12 } });
            }
            if (!nodeSet.Contains(toTrunc))
            {
                nodeSet.Add(toTrunc);
                nodes.Add(new { id = toTrunc, color = "#9E9E9E", marker = new { radius = 12 } });
            }

            // Check if link already exists
            var linkExists = links.Cast<dynamic>().Any(l => l.from == fromTrunc && l.to == toTrunc);
            if (!linkExists)
            {
                links.Add(new { from = fromTrunc, to = toTrunc });
            }
        }

        return new
        {
            chart = new { type = "networkgraph", height = 450 },
            title = new { text = "Lineage Graph" },
            subtitle = new { text = "Green: Current | Blue: Predecessors | Orange: Successors | Gray: History" },
            plotOptions = new
            {
                networkgraph = new
                {
                    keys = new[] { "from", "to" },
                    layoutAlgorithm = new
                    {
                        enableSimulation = true,
                        linkLength = 120,
                        gravitationalConstant = 0.02
                    },
                    link = new { width = 2, color = "#666666" }
                }
            },
            series = new[]
            {
                new
                {
                    marker = new { radius = 15 },
                    dataLabels = new
                    {
                        enabled = true,
                        linkFormat = "",
                        style = new { fontSize = "11px", fontWeight = "normal" },
                        y = -10
                    },
                    link = new { width = 2 },
                    data = links,
                    nodes = nodes
                }
            }
        };
    }

    private string Truncate(string text, int max)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= max)
            return text;
        return text.Substring(0, max) + "...";
    }
}
