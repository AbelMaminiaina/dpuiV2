@inject IJSRuntime JS
@using LignageApp.Models

<div id="@ContainerId" class="lignage-graph-container"></div>

<!-- Debug: Afficher les données du graphe -->
<details style="margin-top:10px; padding:10px; background:#f5f5f5; border-radius:5px;">
    <summary style="cursor:pointer; font-weight:bold;">Debug: Données du graphe (@_linkCount liens, @_nodeCount noeuds)</summary>
    <div style="max-height:300px; overflow-y:auto; font-size:12px;">
        <h5>Noeuds (@_nodeCount)</h5>
        <ul>
            @foreach (var node in _debugNodes)
            {
                <li style="color:@node.Color">@node.Id</li>
            }
        </ul>
        <h5>Liens (@_linkCount)</h5>
        <ul>
            @foreach (var link in _debugLinks)
            {
                <li>@link.From → @link.To</li>
            }
        </ul>
    </div>
</details>

@code {
    // Debug variables
    private List<DebugNode> _debugNodes = new();
    private List<DebugLink> _debugLinks = new();
    private int _nodeCount => _debugNodes.Count;
    private int _linkCount => _debugLinks.Count;

    private class DebugNode { public string Id { get; set; } = ""; public string Color { get; set; } = ""; }
    private class DebugLink { public string From { get; set; } = ""; public string To { get; set; } = ""; }

    [Parameter] public string CurrentNode { get; set; } = string.Empty;
    [Parameter] public List<LineageDto> Successors { get; set; } = new();
    [Parameter] public List<LineageDto> Predecessors { get; set; } = new();
    [Parameter] public List<HistoryEntry> History { get; set; } = new();
    [Parameter] public string ContainerId { get; set; } = "graph-container";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RenderGraph();
    }

    private async Task RenderGraph()
    {
        var config = BuildGraphConfig();
        await JS.InvokeVoidAsync("renderHighchartsGraph", ContainerId, config);
    }

    private object BuildGraphConfig()
    {
        var nodes = new List<object>();
        var links = new List<object>();
        var nodeSet = new HashSet<string>();
        var linkSet = new HashSet<string>(); // Pour éviter les doublons de liens

        // Helper pour ajouter un lien sans doublon - USE FULL NAMES for identification
        void AddLink(string from, string to)
        {
            var linkKey = $"{from}|{to}";
            if (!linkSet.Contains(linkKey) && from != to && !string.IsNullOrEmpty(from) && !string.IsNullOrEmpty(to))
            {
                linkSet.Add(linkKey);
                links.Add(new { from = from, to = to });
            }
        }

        // Helper pour ajouter un noeud - USE FULL NAME for id, truncated for display
        void AddNode(string fullName, string color, int radius)
        {
            if (!nodeSet.Contains(fullName) && !string.IsNullOrEmpty(fullName))
            {
                nodeSet.Add(fullName);
                nodes.Add(new {
                    id = fullName,
                    name = Truncate(fullName, 30),  // Display name (truncated)
                    color = color,
                    marker = new { radius = radius }
                });
            }
        }

        // Current node (green) - USE FULL NAME
        var currentNodeFull = CurrentNode ?? "";
        AddNode(currentNodeFull, "#4CAF50", 25);

        // Predecessors du noeud actuel (blue) - USE FULL NAMES
        foreach (var p in Predecessors)
        {
            var pFull = p.Node ?? "";
            AddNode(pFull, "#2196F3", 15);
            AddLink(pFull, currentNodeFull);
        }

        // Successors du noeud actuel (orange) - USE FULL NAMES
        foreach (var s in Successors)
        {
            var sFull = s.Node ?? "";
            AddNode(sFull, "#FF9800", 15);
            AddLink(currentNodeFull, sFull);
        }

        // History: Parcourir chaque entrée et afficher ses successeurs/prédécesseurs
        foreach (var entry in History)
        {
            var entryFull = entry.Node ?? "";

            // Ajouter le noeud de l'historique s'il n'existe pas (gris)
            AddNode(entryFull, "#9E9E9E", 12);

            // Ajouter les prédécesseurs de chaque entrée de l'historique (bleu clair)
            if (entry.Predecessors != null)
            {
                foreach (var p in entry.Predecessors)
                {
                    var pFull = p.Node ?? "";
                    AddNode(pFull, "#90CAF9", 10);
                    AddLink(pFull, entryFull);
                }
            }

            // Ajouter les successeurs de chaque entrée de l'historique (orange clair)
            if (entry.Successors != null)
            {
                foreach (var s in entry.Successors)
                {
                    var sFull = s.Node ?? "";
                    AddNode(sFull, "#FFCC80", 10);
                    AddLink(entryFull, sFull);
                }
            }
        }

        // Liens entre les noeuds de l'historique (parcours)
        for (int i = 0; i < History.Count - 1; i++)
        {
            var fromFull = History[i].Node ?? "";
            var toFull = History[i + 1].Node ?? "";
            AddLink(fromFull, toFull);
        }

        // Remplir les variables de débogage
        _debugNodes = nodes.Cast<dynamic>().Select(n => new DebugNode { Id = n.id, Color = n.color }).ToList();
        _debugLinks = links.Cast<dynamic>().Select(l => new DebugLink { From = l.from, To = l.to }).ToList();

        return new
        {
            chart = new { type = "networkgraph", height = 500 },
            title = new { text = "Lineage Graph" },
            subtitle = new { text = "Vert: Actuel | Bleu: Predecesseurs | Orange: Successeurs | Gris: Historique | Bleu/Orange clair: Liens historique" },
            plotOptions = new
            {
                networkgraph = new
                {
                    keys = new[] { "from", "to" },
                    layoutAlgorithm = new
                    {
                        enableSimulation = true,
                        linkLength = 120,
                        gravitationalConstant = 0.02
                    },
                    link = new
                    {
                        width = 2,
                        color = "#666666",
                        marker = new
                        {
                            enabled = true,
                            radius = 4
                        }
                    }
                }
            },
            series = new[]
            {
                new
                {
                    type = "networkgraph",
                    marker = new { radius = 15 },
                    dataLabels = new
                    {
                        enabled = true,
                        linkFormat = "",
                        format = "{point.name}",  // Use name property for display
                        style = new { fontSize = "10px", fontWeight = "normal" },
                        y = -10
                    },
                    link = new
                    {
                        width = 3,
                        color = "#333333"
                    },
                    data = links,
                    nodes = nodes
                }
            }
        };
    }

    private string Truncate(string text, int max)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= max)
            return text;
        return text.Substring(0, max) + "...";
    }

}
